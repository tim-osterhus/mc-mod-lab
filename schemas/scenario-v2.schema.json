{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "fixture", "runtime", "steps", "cleanup"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "fixture": {"$ref": "#/$defs/id"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mod_id", "mod_version", "artifact_sha256"],
      "properties": {
        "kind": {"const": "prepared-packaged-client"},
        "mod_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$"},
        "mod_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "artifact_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_keyframes": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/step"}
    },
    "cleanup": {"enum": ["release-control", "save-exit"]}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_id": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$", "maxLength": 128},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "observe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {"enum": ["world", "player", "screen", "frame", "inventory", "nearby_entities", "aura_node", "aura_pump", "storage", "hud_render"]},
              {"$ref": "#/$defs/typed_observation"}
            ]
          }
        },
        "action": {"$ref": "#/$defs/action"},
        "wait": {"$ref": "#/$defs/wait"},
        "require": {"$ref": "#/$defs/require"}
      },
      "oneOf": [
        {"required": ["observe"]},
        {"required": ["action"]},
        {"required": ["wait"]},
        {"required": ["require"]}
      ]
    },
    "typed_observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"],
         "properties": {"type": {"const": "screen_slots"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "x", "y", "z"],
         "properties": {"type": {"const": "block_entity_inventory"},
           "x": {"$ref": "#/$defs/x"}, "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"],
         "properties": {"type": {"const": "aura_accessories"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "radius"],
         "properties": {"type": {"const": "ground_entities"}, "radius": {"type": "integer", "minimum": 1, "maximum": 16}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "z"],
          "properties": {"type": {"const": "aura_storage_fixture"},
            "x": {"$ref": "#/$defs/x"}, "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "z", "target_y"],
          "properties": {"type": {"const": "aura_pump_pair"}, "x": {"$ref": "#/$defs/x"},
            "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"}, "target_y": {"$ref": "#/$defs/y"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "server_tick"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "player_inventory"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "z"],
          "properties": {
            "type": {"const": "aura_block"},
            "x": {"$ref": "#/$defs/x"},
            "y": {"$ref": "#/$defs/y"},
            "z": {"$ref": "#/$defs/x"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x", "y", "z"],
          "properties": {
            "type": {"const": "aura_block_server"},
            "x": {"$ref": "#/$defs/x"},
            "y": {"$ref": "#/$defs/y"},
            "z": {"$ref": "#/$defs/x"}
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "item"],
         "properties": {"type": {"const": "use_selected_item"}, "item": {"$ref": "#/$defs/registry_id"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "seconds", "x", "y", "z"],
         "properties": {"type": {"const": "capture_hud_trace"}, "seconds": {"type": "integer", "minimum": 10, "maximum": 20},
           "trigger": {"const": "drop_selected"},
           "x": {"$ref": "#/$defs/x"}, "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"}}},
        {"type": "object", "additionalProperties": false,
         "required": ["type", "seconds", "sample_every", "require_motion"],
         "properties": {"type": {"const": "capture_animation"},
           "seconds": {"type": "integer", "minimum": 2, "maximum": 10},
           "sample_every": {"type": "integer", "minimum": 20, "maximum": 60},
           "require_motion": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "pressed"],
         "properties": {"type": {"enum": ["set_crouch", "set_forward"]}, "pressed": {"type": "boolean"}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "key"],
          "properties": {"type": {"const": "press_key"}, "key": {"enum": ["Enter", "Escape", "E", "Tab", "B"]}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y"],
          "properties": {"type": {"const": "click"}, "x": {"type": "integer", "minimum": 0, "maximum": 8191}, "y": {"type": "integer", "minimum": 0, "maximum": 8191}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "index"],
          "properties": {"type": {"const": "click_button_index"}, "index": {"type": "integer", "minimum": 0, "maximum": 20}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "use_item"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "slot", "item"],
          "properties": {"type": {"const": "select_hotbar"}, "slot": {"type": "integer", "minimum": 0, "maximum": 8}, "item": {"$ref": "#/$defs/registry_id"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "count"],
          "properties": {"type": {"const": "drop_selected"}, "count": {"type": "integer", "minimum": 1, "maximum": 64}}
        },
        {"$ref": "#/$defs/block_action"}
      ]
    },
    "block_action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "z", "block_id"],
          "properties": {
            "type": {"const": "aim_at_block"},
            "x": {"$ref": "#/$defs/x"}, "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"},
            "block_id": {"$ref": "#/$defs/registry_id"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "z", "block_id"],
          "properties": {
            "type": {"const": "use_item_at_block"},
            "x": {"$ref": "#/$defs/x"}, "y": {"$ref": "#/$defs/y"}, "z": {"$ref": "#/$defs/x"},
            "block_id": {"$ref": "#/$defs/registry_id"}
          }
        }
      ]
    },
    "accessory_slots": {
      "type": "object", "additionalProperties": false,
      "required": ["amulet", "ring1", "ring2", "belt", "cursor"],
      "properties": {"amulet": {"$ref": "#/$defs/accessory_item"}, "ring1": {"$ref": "#/$defs/accessory_item"},
        "ring2": {"$ref": "#/$defs/accessory_item"}, "belt": {"$ref": "#/$defs/accessory_item"},
        "cursor": {"$ref": "#/$defs/accessory_item"}}
    },
    "accessory_item": {"oneOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false, "required": ["item_id", "count", "component_sha256"],
      "properties": {"item_id": {"$ref": "#/$defs/registry_id"}, "count": {"type": "integer", "minimum": 1, "maximum": 64},
        "component_sha256": {"$ref": "#/$defs/hash"}}
    }]},
    "wait": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "count"],
      "properties": {"type": {"const": "ticks"}, "count": {"type": "integer", "minimum": 1, "maximum": 1200}}
    },
    "require": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "slots"],
         "properties": {"type": {"const": "accessory_slots"}, "slots": {"$ref": "#/$defs/accessory_slots"}}},
        {"type": "object", "additionalProperties": false,
         "required": ["type", "before", "after", "entity_id", "minimum_speed", "maximum_speed"],
         "properties": {"type": {"const": "stationary_entity_impulse"},
           "expected_distance": {"type": "number", "minimum": 0.1, "maximum": 16},
           "before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"}, "entity_id": {"$ref": "#/$defs/registry_id"},
           "minimum_speed": {"type": "number", "minimum": 0, "maximum": 4},
           "maximum_speed": {"type": "number", "minimum": 0, "maximum": 4}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "before", "after", "direction", "count", "component_types", "transactions"],
          "properties": {"type": {"const": "storage_transfer"},
            "before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"},
            "direction": {"enum": ["deposit", "withdraw"]},
            "count": {"type": "integer", "minimum": 0, "maximum": 4096},
            "component_types": {"type": "integer", "minimum": 0, "maximum": 64},
            "transactions": {"type": "integer", "minimum": 0, "maximum": 64}}
        },
        {"type": "object", "additionalProperties": false, "required": ["type", "equals"],
         "properties": {"type": {"const": "player_crouching"}, "equals": {"type": "boolean"}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "before", "after", "end", "mode", "expected_aura"],
          "properties": {"type": {"const": "pump_accounting"}, "before": {"$ref": "#/$defs/id"},
            "after": {"$ref": "#/$defs/id"}, "end": {"$ref": "#/$defs/id"},
            "mode": {"enum": ["flow", "unfueled", "blocked"]},
            "expected_aura": {"type": "integer", "minimum": 1, "maximum": 1000000}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "equals"],
          "properties": {"type": {"const": "screen_class"}, "equals": {"type": "string", "minLength": 1, "maxLength": 160}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "equals"],
          "properties": {"type": {"const": "world_name"}, "equals": {"type": "string", "minLength": 1, "maxLength": 160}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "before", "after", "metric", "color", "minimum_delta"],
          "properties": {
            "type": {"const": "aura_increase"}, "before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"},
            "metric": {"const": "aura_by_color"}, "color": {"$ref": "#/$defs/color"},
            "minimum_delta": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "before", "after", "metric", "minimum_delta"],
          "properties": {
            "type": {"const": "aura_increase"}, "before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"},
            "metric": {"enum": ["total_aura", "stored_power", "power", "speed"]},
            "minimum_delta": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "before", "after", "item_id", "expected_count_delta"],
          "properties": {
            "type": {"const": "inventory_conservation"}, "before": {"$ref": "#/$defs/id"}, "after": {"$ref": "#/$defs/id"},
            "item_id": {"$ref": "#/$defs/registry_id"},
            "expected_count_delta": {"type": "integer", "minimum": -4096, "maximum": 4096},
            "expected_component_sha256": {"$ref": "#/$defs/hash"},
            "expected_before_count": {"type": "integer", "minimum": 0, "maximum": 4096},
            "expected_after_count": {"type": "integer", "minimum": 0, "maximum": 4096},
            "pickup_item_id": {"$ref": "#/$defs/registry_id"}
          }
        }
      ]
    },
    "color": {"enum": ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]},
    "x": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
    "y": {"type": "integer", "minimum": -64, "maximum": 319}
  }
}
