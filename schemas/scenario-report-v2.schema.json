{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "scenario", "scenario_sha256", "status", "evidence_kind", "fixture_id", "runtime", "steps", "cleanup", "visual_check", "artifacts", "memory"],
  "properties": {
    "schema_version": {"const": 2},
    "created_at": {"type": "string", "format": "date-time"},
    "scenario": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "scenario_sha256": {"$ref": "#/$defs/hash"},
    "status": {"$ref": "#/$defs/status"},
    "evidence_kind": {"enum": ["live", "diagnostic_live", "offline_control"]},
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "mod_id", "mod_version", "artifact_sha256", "bridge_sha256", "profile_kind", "bridge_classification"],
      "properties": {
        "status": {"enum": ["verified", "unsupported"]},
        "mod_id": {"type": "string"},
        "mod_version": {"type": "string"},
        "artifact_sha256": {"$ref": "#/$defs/hash"},
        "bridge_sha256": {"$ref": "#/$defs/hash"},
        "profile_kind": {"const": "prepared-packaged-client"},
        "bridge_classification": {"enum": ["private_diagnostic", "public_reviewed", "unreviewed"]},
        "reason": {"type": "string", "maxLength": 240}
      }
    },
    "steps": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/step"}},
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"$ref": "#/$defs/status"}, "reason": {"type": "string", "maxLength": 240}}
    },
    "visual_check": {"enum": ["not_reviewed", "pass", "fail", "inconclusive"]},
    "visual_reviewer": {"type": "string", "minLength": 1, "maxLength": 100},
    "artifacts": {
      "type": "array", "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false, "required": ["file", "sha256"],
        "properties": {"file": {"type": "string", "minLength": 1, "maxLength": 180}, "sha256": {"$ref": "#/$defs/hash"}}}
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["working_set_limit_mib", "peak_working_set_mib", "peak_private_mib", "samples", "hard_cap"],
      "properties": {
        "working_set_limit_mib": {"type": "number", "exclusiveMinimum": 0, "maximum": 3800},
        "peak_working_set_mib": {"type": ["number", "null"], "minimum": 0},
        "peak_private_mib": {"type": ["number", "null"], "minimum": 0},
        "samples": {"type": "integer", "minimum": 0},
        "hard_cap": {"const": false}
      }
    },
    "reason": {"type": "string", "maxLength": 240}
  },
  "allOf": [
    {"if": {"properties": {"visual_check": {"enum": ["pass", "fail"]}}},
     "then": {"required": ["visual_reviewer"]}}
  ],
  "$defs": {
    "pump_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "server_authoritative", "server_tick", "world_time", "x", "y", "z", "target_y", "pump_aura", "target_aura", "power", "speed", "blocked", "inhibited", "ground_coal", "inventory_coal"],
      "properties": {
        "type": {"const": "aura_pump_pair"}, "server_authoritative": {"const": true},
        "server_tick": {"type": "integer", "minimum": 0}, "world_time": {"type": "integer", "minimum": 0},
        "x": {"type": "integer"}, "y": {"type": "integer"}, "z": {"type": "integer"}, "target_y": {"type": "integer"},
        "pump_aura": {"type": "integer", "minimum": 0}, "target_aura": {"type": "integer", "minimum": 0},
        "power": {"type": "integer", "minimum": 0}, "speed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "boolean"}, "inhibited": {"type": "boolean"},
        "ground_coal": {"type": "integer", "minimum": 0}, "inventory_coal": {"type": "integer", "minimum": 0}
      }
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail", "inconclusive", "unsupported", "not_run"]},
    "typed_observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["type", "server_authoritative", "server_tick", "player_key", "slots"],
         "properties": {"type": {"const": "aura_accessories"}, "server_authoritative": {"const": true},
           "server_tick": {"type": "integer", "minimum": 0}, "player_key": {"$ref": "#/$defs/hash"},
           "slots": {"type": "object", "additionalProperties": false,
             "required": ["amulet", "ring1", "ring2", "belt", "cursor"],
             "properties": {"amulet": {"$ref": "#/$defs/accessory_item"}, "ring1": {"$ref": "#/$defs/accessory_item"},
               "ring2": {"$ref": "#/$defs/accessory_item"}, "belt": {"$ref": "#/$defs/accessory_item"},
               "cursor": {"$ref": "#/$defs/accessory_item"}}}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "server_authoritative", "server_tick", "radius", "dimension", "player_position", "entities"],
          "properties": {"type": {"const": "ground_entities"}, "server_authoritative": {"const": true},
            "server_tick": {"type": "integer", "minimum": 0}, "radius": {"type": "integer", "minimum": 1, "maximum": 16},
            "dimension": {"type": "string", "maxLength": 128}, "player_position": {"$ref": "#/$defs/vector"},
            "entities": {"type": "array", "maxItems": 64, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["entity_id", "entity_key", "alive", "position", "velocity"],
              "properties": {"entity_id": {"type": "string", "maxLength": 128}, "entity_key": {"$ref": "#/$defs/hash"},
                "alive": {"type": "boolean"}, "position": {"$ref": "#/$defs/vector"}, "velocity": {"$ref": "#/$defs/vector"},
                "health": {"type": "number", "minimum": 0}, "item_components_complete": {"type": "boolean"},
                "item": {"$ref": "#/$defs/storage_item"}}
            }}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "server_authoritative", "server_tick", "x", "y", "z", "power", "transaction_cost", "inventory", "storage"],
          "properties": {
            "type": {"const": "aura_storage_fixture"}, "server_authoritative": {"const": true},
            "server_tick": {"type": "integer", "minimum": 0},
            "x": {"type": "integer"}, "y": {"type": "integer"}, "z": {"type": "integer"},
            "power": {"type": "integer", "minimum": 0}, "transaction_cost": {"const": 5},
            "inventory": {"type": "array", "maxItems": 41, "items": {"$ref": "#/$defs/storage_item"}},
            "storage": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/storage_item"}}
          }
        },
        {"$ref": "#/$defs/pump_pair"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "server_tick"],
          "properties": {
            "type": {"const": "server_tick"}, "server_tick": {"type": "integer", "minimum": 0},
            "server_tick_before": {"type": ["integer", "null"], "minimum": 0},
            "server_tick_after": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "stack_count", "component_digests_complete", "server_tick_before", "server_tick_after"],
          "properties": {
            "type": {"const": "player_inventory"}, "stack_count": {"type": "integer", "minimum": 0, "maximum": 41},
            "component_digests_complete": {"type": "boolean"}, "inventory_sha256": {"$ref": "#/$defs/hash"},
            "crouching": {"type": "boolean"},
            "items": {"type": "array", "maxItems": 41, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["item_id", "count", "component_sha256"],
              "properties": {"item_id": {"type": "string", "maxLength": 128},
                "count": {"type": "integer", "minimum": 1}, "component_sha256": {"$ref": "#/$defs/hash"}}
            }},
            "server_authoritative": {"type": "boolean"}, "state_source": {"type": "string", "maxLength": 64},
            "server_tick_before": {"type": ["integer", "null"], "minimum": 0},
            "server_tick_after": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "x", "y", "z", "block_id", "aura_kind", "server_authoritative", "server_tick_before", "server_tick_after", "snapshot_sha256"],
          "properties": {
            "type": {"enum": ["aura_block", "aura_block_server"]},
            "x": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
            "y": {"type": "integer", "minimum": -64, "maximum": 319},
            "z": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
            "block_id": {"type": "string", "maxLength": 128},
            "aura_kind": {"enum": ["NODE", "PUMP", "STORAGE_BOOKSHELF", "UNKNOWN"]},
            "server_authoritative": {"type": "boolean"}, "state_source": {"type": "string", "maxLength": 64},
            "server_tick_before": {"type": ["integer", "null"], "minimum": 0},
            "server_tick_after": {"type": ["integer", "null"], "minimum": 0},
            "snapshot_sha256": {"$ref": "#/$defs/hash"}
          }
        }
      ]
    },
    "accessory_item": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/storage_item"}]},
    "vector": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}
    },
    "storage_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "count", "component_sha256"],
      "properties": {"item_id": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
        "count": {"type": "integer", "minimum": 1}, "component_sha256": {"$ref": "#/$defs/hash"}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
        "kind": {"enum": ["observe", "action", "wait", "require"]},
        "status": {"$ref": "#/$defs/status"},
        "at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "maxLength": 240},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "hud_capture": {
              "type": "object", "additionalProperties": false,
              "required": ["trace_file", "frame_count", "keyframe_count", "visual_status"],
              "properties": {"trace_file": {"type": "string", "maxLength": 180},
                "frame_count": {"type": "integer", "minimum": 1, "maximum": 1200},
                "keyframe_count": {"type": "integer", "minimum": 1, "maximum": 64},
                "visual_status": {"const": "not_reviewed"}}
            },
            "pump_accounting": {
              "type": "object", "additionalProperties": false,
              "required": ["mode", "before", "after", "end", "expected_aura"],
              "properties": {"mode": {"enum": ["flow", "unfueled", "blocked"]},
                "before": {"$ref": "#/$defs/pump_pair"}, "after": {"$ref": "#/$defs/pump_pair"},
                "end": {"$ref": "#/$defs/pump_pair"}, "expected_aura": {"type": "integer", "minimum": 1}}
            },
            "world_name": {"type": "string", "maxLength": 160},
            "screen_class": {"type": ["string", "null"], "maxLength": 160},
            "screenshot": {"type": "string", "maxLength": 180},
            "player_gamemode": {"enum": ["creative", "survival", "adventure", "spectator"]},
            "player_dimension": {"type": "string", "maxLength": 160},
            "action_type": {"type": "string", "maxLength": 80},
            "acknowledged": {"type": "boolean"},
            "acknowledgement_status": {"type": "string", "maxLength": 32},
            "server_tick_before": {"type": ["integer", "null"], "minimum": 0},
            "server_tick_after": {"type": ["integer", "null"], "minimum": 0},
            "ticks_elapsed": {"type": "integer", "minimum": 0},
            "ticks_requested": {"type": "integer", "minimum": 1, "maximum": 1200},
            "typed_observations": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/typed_observation"}},
            "assertion": {"type": "string", "maxLength": 80},
            "observed": {"type": ["string", "number", "boolean", "null"], "maxLength": 160},
            "entity_key": {"$ref": "#/$defs/hash"},
            "expected_component_sha256": {"$ref": "#/$defs/hash"},
            "observed_distance": {"type": "number", "minimum": 0, "maximum": 16},
            "minimum_speed": {"type": "number", "minimum": 0, "maximum": 4},
            "maximum_speed": {"type": "number", "minimum": 0, "maximum": 4},
            "metric": {"enum": ["aura_by_color", "total_aura", "stored_power", "power", "speed"]},
            "color": {"enum": ["white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black"]},
            "before_value": {"type": "number"},
            "after_value": {"type": "number"},
            "delta": {"type": "number"},
            "minimum_delta": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "server_authoritative": {"type": "boolean"},
            "x": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
            "y": {"type": "integer", "minimum": -64, "maximum": 319},
            "z": {"type": "integer", "minimum": -30000000, "maximum": 30000000},
            "block_id": {"type": "string", "maxLength": 128},
            "aura_kind": {"enum": ["NODE", "PUMP", "STORAGE_BOOKSHELF", "UNKNOWN"]},
            "before_inventory_sha256": {"$ref": "#/$defs/hash"},
            "after_inventory_sha256": {"$ref": "#/$defs/hash"},
            "component_digests_complete": {"type": "boolean"},
            "expected_count_delta": {"type": "integer", "minimum": -4096, "maximum": 4096},
            "actual_count_delta": {"type": "integer", "minimum": -4096, "maximum": 4096},
            "before_count": {"type": "integer", "minimum": 0},
            "after_count": {"type": "integer", "minimum": 0},
            "pickup_item_id": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
            "pickup_count_delta": {"const": 1}
          }
        }
      }
    }
  }
}
